APP_NAME="GreenCA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_CODE_PREFIX=SGO
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=green_car_airport
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Reverb — WebSocket server, chạy như một tiến trình RIÊNG (php artisan reverb:start).
# Không chạy tiến trình đó thì app vẫn sống nhưng KHÔNG có cập nhật realtime nào.
# ⚠️ Cổng phải khác 8080 (nginx đang dùng). APP_ID/KEY/SECRET sinh riêng cho mỗi
# môi trường — không dùng chung dev với production.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8081
REVERB_SCHEME=http

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@greenca.vn"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@greenca.vn

# Tài khoản nhận tiền nạp điểm của tài xế. Hiện lên app tài xế (màn Nạp điểm)
# và dùng để sinh mã QR VietQR — điền SAI là tài xế chuyển tiền vào nhầm tài khoản.
# Giá trị THẬT chỉ đặt trong .env trên server, không commit vào git.
# SEPAY_BANK_CODE dùng mã VietQR: VCB, TCB, MB, ACB, BIDV... (xem img.vietqr.io)
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_NAME=
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT_NUMBER=
SEPAY_BANK_ACCOUNT_HOLDER=
SEPAY_MIN_AMOUNT_VND=10000

ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REFRESH_TOKEN=
ZALO_OTP_TEMPLATE_ID=

FEATURE_AUTO_TOPUP=true

ZNS_PROVIDER=southtelecom
ZNS_FORCE_SEND=false

SOUTHTELECOM_ZNS_BASE_URL=https://api-04.worldsms.vn/apidebit
SOUTHTELECOM_ZNS_USER=
SOUTHTELECOM_ZNS_PASSWORD=
SOUTHTELECOM_ZNS_FROM=
SOUTHTELECOM_ZNS_TEMPLATE_ID=
SOUTHTELECOM_ZNS_DLR_TOKEN=

ABENLA_BASE_URL=https://api.abenla.com/api
ABENLA_LOGIN_NAME=
ABENLA_SIGN=
ABENLA_SERVICE_TYPE_ID=
ABENLA_BRAND_NAME=
