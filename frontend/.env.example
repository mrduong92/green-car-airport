VITE_GOONG_API_KEY=
VITE_GOONG_MAP_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_CODE_PREFIX=GCA
VITE_DRIVER_APP_URL=http://localhost:5174
# Reverb (WebSocket realtime) — phải khớp REVERB_* trong backend/.env.
# Không có 4 biến này thì app vẫn chạy nhưng KHÔNG có cập nhật realtime.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http
