VITE_GOONG_API_KEY=
VITE_GOONG_MAP_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_CODE_PREFIX=GCA
VITE_DRIVER_APP_URL=http://localhost:5174
# Reverb (WebSocket realtime).
#
# BẮT BUỘC: phải khớp REVERB_APP_KEY trong backend/.env. Thiếu là mất realtime.
VITE_REVERB_APP_KEY=

# 3 biến dưới CHỈ cần cho dev (Reverb chạy cổng 8081 riêng).
# Trên staging/production ĐỪNG đặt: client tự nối về chính domain đang mở qua
# 443, nginx đã proxy `location /app/`. Đặt cứng host ở đây là 2 trong 3 app sẽ
# nối cross-origin.
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http
