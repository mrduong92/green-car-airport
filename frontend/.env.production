# Build cho PRODUCTION: npm run build:customer -- --mode production
#
# Vì sao cần file này: Vite ưu tiên `.env` HƠN biến môi trường truyền lúc build,
# nên truyền `-e VITE_REVERB_APP_KEY=...` sẽ bị giá trị dev trong `.env` ghi đè —
# bundle production mang key dev, Reverb từ chối kết nối, mất realtime mà không
# có lỗi nào rõ ràng. Chỉ file theo mode mới thắng được `.env`.
#
# REVERB_APP_KEY là định danh CÔNG KHAI (nằm trong URL WebSocket), không phải bí
# mật — chỉ REVERB_APP_SECRET mới cần giữ kín và nó chỉ nằm ở backend/.env.

VITE_REVERB_APP_KEY=8116c288a0e864f758b94322b1898c94

# Bỏ trống để ghi đè giá trị dev trong `.env`: client tự nối về chính domain
# đang mở qua 443 (nginx đã proxy `location /app/`).
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=

VITE_DRIVER_APP_URL=https://driver.greenca.vn
