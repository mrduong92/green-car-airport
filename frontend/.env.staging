# Build cho STAGING: npm run build:customer -- --mode staging
#
# Vì sao cần file này thay vì truyền biến môi trường lúc build: Vite ưu tiên
# file `.env` HƠN biến môi trường truyền vào, nên `-e VITE_REVERB_APP_KEY=...`
# bị `.env` (giá trị dev) ghi đè — bundle staging mang key dev, Reverb từ chối
# kết nối và mất realtime mà không có lỗi nào rõ ràng. File theo mode thì thắng
# `.env`, nên đây là cơ chế duy nhất chắc chắn.
#
# REVERB_APP_KEY là định danh CÔNG KHAI (nằm ngay trong URL WebSocket), không
# phải bí mật — chỉ REVERB_APP_SECRET mới cần giữ kín và nó chỉ nằm ở backend.

VITE_REVERB_APP_KEY=6eedc79ae38c5275810a4842d513928d

# Bỏ trống 3 biến dưới để ghi đè giá trị dev trong `.env`: client tự nối về
# chính domain đang mở qua 443 (nginx đã proxy `location /app/`).
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=

VITE_DRIVER_APP_URL=https://driver.webco.io.vn
