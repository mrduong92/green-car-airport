# URL gốc backend Laravel (không có dấu / cuối)
API_BASE_URL=https://greenca.vn
# Trùng ZALO_BOT_SECRET trong backend/.env
BOT_SECRET=
SERVICE_ID=zalo-1
# Thư mục dữ liệu: zalo.sqlite + accounts/<tên>.json (phiên đăng nhập từng tài khoản phụ)
DATA_DIR=/opt/greenca-zalo-service/data

# Chỉ nhận tin từ các nhóm này (cách nhau dấu phẩy; bỏ trống = mọi nhóm). Lấy ID: npm run groups -- acc1
ALLOWED_GROUP_IDS=

# --- Giai đoạn 2/5: tách cuốc bằng AI (mọi tin không trùng), gửi cuốc sang Laravel ---
# (mọi biến dưới đây có mặc định, bỏ trống được)

# Provider AI: openai (mặc định) hoặc anthropic. Chỉ cần khoá của provider đang chọn.
AI_PROVIDER=openai
# Khoá OpenAI. Trống (và không dùng anthropic) = không gọi AI: quy tắc dự phòng tự tách, không tách
# được thì hiển thị nguyên văn — không mất cuốc, chỉ là tỷ lệ tách đúng chiều thấp hơn nhiều.
OPENAI_API_KEY=
# Dùng khi AI_PROVIDER=anthropic (không cần nếu dùng OpenAI)
ANTHROPIC_API_KEY=
# Mặc định theo provider: gpt-4.1-mini (openai) / claude-haiku-4-5 (anthropic). Đổi model chỉ cần sửa dòng này.
AI_MODEL=gpt-4.1-mini
# Trần chi phí AI mỗi ngày (USD) khi chưa hỏi được Laravel; giá trị hiện hành lấy từ ZALO_AI_DAILY_BUDGET_USD (Laravel)
AI_DAILY_BUDGET_USD=5
# Gom tối đa AI_BATCH_SIZE tin hoặc mỗi AI_FLUSH_MS mili giây một lần gọi AI (giãn nhịp: chấp nhận trễ 30–60 giây)
AI_BATCH_SIZE=20
AI_FLUSH_MS=30000

# Gửi cuốc sang Laravel: lô tối đa 100 (lớn hơn vẫn bị chặn về 100), mỗi RIDES_FLUSH_MS
RIDES_BATCH_SIZE=100
RIDES_FLUSH_MS=30000
# Hỏi cấu hình Laravel (nhóm tắt, người bị chặn, ngân sách AI) / gửi danh sách nhóm
CONFIG_POLL_MS=60000
GROUPS_SYNC_MS=600000

# --- Giai đoạn 4: quét toàn bộ nhóm của nick phụ (chỉ đọc), đồng bộ cho trang admin ---

# Quét getAllGroups + getGroupInfo mỗi nick mỗi GROUP_SCAN_MS; cũng quét một lần ngay sau khi có nick đăng nhập
GROUP_SCAN_MS=1800000

# Hết hạn cuốc: giờ đón + 30 phút; không ghi giờ → giờ đăng + 3 giờ. Khi khởi động, tin chưa xử lý
# cũ hơn RIDE_EXPIRE_WITHOUT_TIME_MS bị bỏ (trạng thái expired), không gọi AI
RIDE_EXPIRE_AFTER_PICKUP_MS=1800000
RIDE_EXPIRE_WITHOUT_TIME_MS=10800000

# Lấy mã QR người bắn: cách nhau QR_INTERVAL_MS (≥ 2000), làm mới sau QR_REFRESH_DAYS ngày
QR_INTERVAL_MS=2000
QR_REFRESH_DAYS=7

# Khác (giai đoạn 1)
HEARTBEAT_MS=60000
ACCOUNT_RETRY_MS=60000
RETENTION_DAYS=7
DUPLICATE_WINDOW_HOURS=24
MAX_CONTENT_LENGTH=4000
