[Unit]
Description=GreenCA Reverb — WebSocket server (realtime)
After=network.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/green-car-airport/backend

# Bind 127.0.0.1 chứ KHÔNG 0.0.0.0: nginx đứng trước proxy WSS qua 443, nên
# không cần và không nên phơi cổng 8081 ra ngoài (ufw chỉ mở 22/80/443, nhưng
# đây là lớp phòng thủ thứ hai nếu firewall bị nới).
ExecStart=/usr/bin/php artisan reverb:start --host=127.0.0.1 --port=8081

# ⚠️ BẮT BUỘC. Mỗi kết nối WebSocket = 1 file descriptor. Mặc định soft limit là
# 1024 nên Reverb đứng ở ~1000 kết nối rồi từ chối phần còn lại — đo được trên
# production 2026-08-09: trần đúng 1003 conn / 1010 fd, trong khi RAM mới dùng
# 82MB và CPU 0,3%. Tức là nghẽn ở fd chứ không phải tài nguyên.
# Ghi cả soft:hard, chỉ đặt hard là vô nghĩa vì tiến trình dùng soft.
LimitNOFILE=65535:65535

Restart=always
RestartSec=3
StandardOutput=append:/var/log/greenca-reverb.log
StandardError=append:/var/log/greenca-reverb.log

[Install]
WantedBy=multi-user.target
